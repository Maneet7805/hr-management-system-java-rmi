# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# --- Project-specific ---
# Secrets and TLS material: never commit
*.jks
*.p12
*.pfx
*.keystore
*.truststore
*.truststore.new
*.cer
.env
*.env
config.properties

# Local databases and data
*.db
*.sqlite
*.sqlite3
data/

# Build output
out/
bin/
build/
target/

# IDEs
.idea/
*.iml
.vscode/
.classpath
.project
.settings/
nbproject/
nbbuild/
dist/

# OS files
.DS_Store
Thumbs.db

# Real config: only the *.example.properties templates are committed
config/*.properties
!config/*.example.properties
